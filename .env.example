# SMTP — contact form email delivery
# Only MAIL_SMTP_PASS is required; other fields have sensible defaults.
MAIL_SMTP_HOST=smtp.migadu.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=info@ndrp.dk
MAIL_SMTP_PASS=

# Optional — override the recipient if needed
CONTACT_TO_EMAIL=info@ndrp.dk

# Cron / notifications
# CRON_SECRET secures the cron endpoints (?secret=...). Reused as the secret in
# the QStash callback URL for the abandoned-leads check.
CRON_SECRET=
# RESEND_API_KEY drives all transactional + cron email (sign, contact, reports).
RESEND_API_KEY=
# DATABASE_URL = Neon (serverless Postgres) connection string for lead/session tracking.
DATABASE_URL=

# Abandoned-CVR notifications (Mads gets the lead ~20 min after CVR if unfinished)
# QSTASH_TOKEN = Upstash QStash token. Schedules the one-shot 20-min check.
# If unset, the feature degrades to the daily Vercel cron backstop only.
QSTASH_TOKEN=
# SITE_ORIGIN = public origin QStash calls back to (defaults to the prod domain).
SITE_ORIGIN=https://nordanriskpartners.dk
